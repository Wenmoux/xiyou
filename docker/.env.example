# ---------- 访问端口 ----------
# 宿主机端口（若 80 被占用就换个端口，如 8080 / 8090）
HTTP_PORT=8080

# ---------- 站点地址 ----------
# 游戏内"返回官网""选区传送"等绝对链接用的地址。
# 局域网部署填内网 IP，公网部署填公网 IP 或域名
SITE_HOST=localhost
SITE_PORT=8080
# 想完全自定义（如带域名或反代前缀）时填这里，会覆盖上面两项
SITE_HOST_OVERRIDE=

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_USER=hxxy
DB_PASS=change_me_db_password
