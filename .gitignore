# ---------- 快照/工具 ----------
.alma-snapshots/
.idea/
.DS_Store
Thumbs.db
*~

# ---------- 部署环境（含真实密码，绝不入库） ----------
docker/.env
*.env
!.env.example

# ---------- Windows 原端二进制（体积大且无跨平台价值） ----------
