phpstudy/tmp/
phpstudy/IIS/
phpstudy/backup/
phpstudy/*.exe
phpstudy/*.dll
phpstudy/*.chm
phpstudy/manual.chm
phpstudy/install.log
phpstudy/phpshao.dll

